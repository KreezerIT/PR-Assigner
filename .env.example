# Server
SERVER_PORT=8080

# Logger
LOG_LEVEL=info

# Database (Production)
DB_HOST=postgres
DB_PORT=5432
DB_USER=prservice
DB_PASSWORD=prservice_pass
DB_NAME=prservice
DB_SSLMODE=disable

# Database pool & retry settings
DB_MAX_RETRIES=5
DB_RETRY_DELAY=2s
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Test Database
TEST_DB_HOST=postgres_test
TEST_DB_PORT=5432
TEST_DB_USER=prservice_test
TEST_DB_PASSWORD=test_pass
TEST_DB_NAME=pr_reviewer_test